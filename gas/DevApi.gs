/**
 * data 시트가 비어있을 때 예시 문제를 채워주는 유틸 (운영자가 실제 문제로 교체하기 전 참고용)
 */

function seedSampleData_() {
  var sheet = getSheet_('data');
  var existing = sheetToObjects_(sheet);
  if (existing.length > 0) return { seeded: false, reason: '이미 데이터가 있습니다.', count: existing.length };

  var samples = [
    ['화재 발생 시 가장 먼저 해야 할 일은?', '대피 방송', '짐 챙기기', '엘리베이터 이용', '사진 촬영', '대피 방송'],
    ['소화기 사용 순서 중 가장 먼저 할 일은?', '안전핀 제거', '분사', '큰 소리로 알리기', '손잡이 강하게 누르기', '안전핀 제거'],
    ['작업 전 안전점검 항목이 아닌 것은?', '보호구 착용상태', '작업발판 고정상태', '점심 메뉴', '전기설비 접지상태', '점심 메뉴'],
    ['밀폐공간 작업 시 반드시 측정해야 하는 것은?', '산소농도', '실내온도', '조도', '습도', '산소농도'],
    ['추락 방지를 위한 대표적 안전장치는?', '안전난간', '선풍기', '소화기', '경광등', '안전난간'],
    ['중량물 운반 시 올바른 자세는?', '허리로 들기', '무릎을 굽혀 들기', '한 손으로 들기', '빠르게 들기', '무릎을 굽혀 들기'],
    ['전기 작업 전 확인해야 할 것은?', '정전 여부', '날씨', '점심시간', '주차 위치', '정전 여부'],
    ['MSDS(물질안전보건자료)의 목적은?', '화학물질 위험정보 제공', '급여명세', '출퇴근 기록', '식단표', '화학물질 위험정보 제공'],
    ['작업 중 이상 발견 시 가장 먼저 할 일은?', '작업중지 및 보고', '계속 작업', '무시하고 진행', '동료에게만 얘기', '작업중지 및 보고'],
    ['안전모 착용 규정으로 옳은 것은?', '작업장 내 항상 착용', '실내에서만 착용', '더울 때는 벗기', '관리자만 착용', '작업장 내 항상 착용'],
    ['지게차 운행 중 지켜야 할 사항은?', '제한속도 준수', '통화하며 운행', '적재물 시야 가림 허용', '급회전', '제한속도 준수']
  ];

  samples.forEach(function (row, idx) {
    appendObject_('data', {
      id: idx + 1,
      category: '안전상식',
      question: row[0],
      choice1: row[1], choice2: row[2], choice3: row[3], choice4: row[4],
      answer: row[5],
      points: 10,
      active: true
    });
  });

  return { seeded: true, count: samples.length };
}
